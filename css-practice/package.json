  "type": "module",
  "packageManager": "yarn@4.18.0",
  "devDependencies": {
    "concurrently": "^10.0.3",
    "live-server": "^1.2.2",
    "repomix": "^1.16.1",
    "sass": "^1.101.0"
  },
  "scripts": {
    "sass:build": "sass src:public",
    "sass:watch": "sass --watch src:public",
    "live": "live-server public --port=6002",
    "dev": "concurrently 'yarn sass:watch' 'yarn live'",
    "format": "prettier --write ."
  }
}
